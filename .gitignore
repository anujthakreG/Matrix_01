# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Local SQLite databases and data directories
/data/
*.db
*.sqlite
*.sqlite3

# Environment variables and secrets (NEVER commit secrets)
.env
*.env.local

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/

# OS artifacts
.DS_Store
Thumbs.db

# Machine Learning artifacts and raw datasets (retain .gitkeep)
backend/artifacts/*
!backend/artifacts/.gitkeep
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
*.joblib
*.pkl
