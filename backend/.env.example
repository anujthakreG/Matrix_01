# MATRIX Intel Backend Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or production credentials to version control.

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME="MATRIX Intel Cybercrime Analysis API"
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security and CORS
# Comma-separated list of allowed frontend origins (e.g., Vite/React dev servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database Settings
# Local development default: SQLite
DATABASE_URL=sqlite:///./data/matrix.db
# IBM LinuxONE Production examples:
# DATABASE_URL=postgresql+psycopg2://db_user:db_password@postgres-host:5432/matrix_db
# DATABASE_URL=ibm_db_sa://db2inst1:password@db2-host:50000/matrixdb

# Worker 2 ML Module Integration
# Path or module identifier for Worker 2's model artifact or predictor class
ML_MODEL_ENABLED=false
ML_MODEL_ARTIFACT_PATH=./app/ml/artifacts/model.joblib
